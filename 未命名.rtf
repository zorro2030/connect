      background: #09224d;\
      color: #fff;\
      padding: 13px 20px;\
      border-radius: 8px;\
      font-size: 12px;\
      opacity: 0;\
      pointer-events: none;\
      transition: 0.3s;\
      z-index: 80;\
      white-space: nowrap;\
    \}\
\
    .toast.show \{\
